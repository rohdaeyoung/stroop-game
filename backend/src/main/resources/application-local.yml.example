# 이 파일을 application-local.yml 로 복사한 뒤 본인 DB 정보로 채우세요.
# application-local.yml 은 .gitignore 처리되어 있습니다 (비밀번호 커밋 방지).
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/stroop?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 여기에_본인_비밀번호
    driver-class-name: com.mysql.cj.jdbc.Driver
